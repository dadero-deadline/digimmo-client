{
  "manifest_version": 3,
  "name": "DigiMMO Tweaks",
  "version": "0.1.0",
  "version_name": "0.1",
  "description": "Optional lighting, shadows, reflections and regional ambience for DigiMMO. Unofficial. Press F10 in game for settings.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [{
    "matches": ["https://play.digimmo.com.br/*"],
    "js": ["digimmo-tweaks.js"],
    "run_at": "document_start",
    "world": "MAIN",
    "all_frames": false
  }],
  "browser_specific_settings": {
    "gecko": {
      "id": "digimmo-tweaks@dadero",
      "strict_min_version": "128.0"
    }
  }
}

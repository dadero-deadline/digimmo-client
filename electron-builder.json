{
  "appId": "com.dadero.digimmo",
  "productName": "DigiMMO",
  "directories": {"output": "dist/installer"},
  "extraMetadata": {"name": "digimmo-client", "main": "main.js", "desktopName": "digimmo.desktop"},
  "files": [
    "package.json",
    {"from": "dist/public/client", "to": ".", "filter": ["main.js", "preload.js", "updater.js", "discord.js", "tweaks.user.js", "icon.png", "icon.ico"]}
  ],
  "extraResources": [
    {"from": "dist/public/LICENSE", "to": "LICENSE"},
    {"from": "dist/public/UPDATES.md", "to": "UPDATES.md"},
    {"from": "dist/public/SOUND_CREDITS.md", "to": "SOUND_CREDITS.md"},
    {"from": "dist/public/KEYBOARD.md", "to": "KEYBOARD.md"},
    {"from": "dist/public/CHANGELOG.md", "to": "CHANGELOG.md"}
  ],
  "extraFiles": [
    {"from": "dist/public/digimmo-tweaks.user.js", "to": "scripts/digimmo-tweaks.user.js"},
    {"from": "dist/public/extension-chromium", "to": "extension"}
  ],
  "asar": true,
  "npmRebuild": false,
  "toolsets": {"appimage": "1.0.3"},
  "win": {"target": [{"target": "nsis", "arch": ["x64"]}], "icon": "client/icon.ico"},
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": false,
    "installerIcon": "client/icon.ico",
    "uninstallerIcon": "client/icon.ico",
    "include": "client/installer.nsh",
    "artifactName": "DigiMMO-Setup-${version}-${arch}.${ext}"
  },
  "linux": {
    "target": [{"target": "AppImage", "arch": ["x64"]}],
    "icon": "client/icon.png",
    "category": "Game",
    "executableName": "digimmo",
    "syncDesktopName": true,
    "synopsis": "DigiMMO desktop client",
    "artifactName": "DigiMMO-${version}-${arch}.${ext}"
  },
  "publish": [{"provider": "github", "owner": "dadero-deadline", "repo": "digimmo-client", "releaseType": "release"}]
}
